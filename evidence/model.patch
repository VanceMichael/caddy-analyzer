+		t.Error("single-source summary must not render the Top Sources block")
+	}
+}
+
+// renderString renders one view of the model.
+func (m Model) renderString(v view) string {
+	var b strings.Builder
+	switch v {
+	case viewSummary:
+		m.renderSummary(&b)
+	case viewRealtime:
+		m.renderRealtime(&b)
+	}
+	return b.String()
+}
