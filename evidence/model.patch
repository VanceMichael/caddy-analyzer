diff --git a/pkg/guard/lock_unix.go b/pkg/guard/lock_unix.go
new file mode 100644
index 0000000..9f1d7fd
--- /dev/null
+++ b/pkg/guard/lock_unix.go
@@ -0,0 +1,20 @@
+//go:build !windows
+
+package guard
+
+import (
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// lockFile takes a blocking exclusive advisory lock (flock) on f. All
+// cooperating binaries must lock the same sidecar path; the lock is
+// released automatically when the descriptor is closed.
+func lockFile(f *os.File) error {
+	return unix.Flock(int(f.Fd()), unix.LOCK_EX)
+}
+
+func unlockFile(f *os.File) error {
+	return unix.Flock(int(f.Fd()), unix.LOCK_UN)
+}
diff --git a/pkg/guard/lock_windows.go b/pkg/guard/lock_windows.go
new file mode 100644
index 0000000..ac9d490
--- /dev/null
+++ b/pkg/guard/lock_windows.go
@@ -0,0 +1,22 @@
+//go:build windows
+
+package guard
+
+import (
+	"os"
+
+	"golang.org/x/sys/windows"
+)
+
+// lockFile takes a blocking exclusive byte-range lock on f. The range is
+// advisory across processes that use the same lock file.
+func lockFile(f *os.File) error {
+	var ol windows.Overlapped
+	return windows.LockFileEx(windows.Handle(f.Fd()), windows.LOCKFILE_EXCLUSIVE_LOCK,
+		0, ^uint32(0), ^uint32(0), &ol)
+}
+
+func unlockFile(f *os.File) error {
+	var ol windows.Overlapped
+	return windows.UnlockFileEx(windows.Handle(f.Fd()), 0, ^uint32(0), ^uint32(0), &ol)
+}
